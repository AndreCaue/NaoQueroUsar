# Frontend — variáveis de ambiente (EmpregaNoix)
#
# Copie para `.env.local` e ajuste. NUNCA comite `.env.local` nem valores
# reais de produção. Nenhum `NEXT_PUBLIC_*` pode conter segredos: tudo que
# começa com NEXT_PUBLIC_ vai embutido no bundle do navegador.
#
# Produção (Vercel, state-alvo canônico): configure estas vars no dashboard (Production scope).
# Frontend (origem canônica): https://empreganoix.vercel.app
# Backend (API canônica): https://empreganoix.onrender.com
# Desde WR-04, `next build` FALHA se NEXT_PUBLIC_API_URL estiver ausente —
# não existe mais fallback para localhost em build de produção.
# `NEXT_PUBLIC_*` é embutida no build e exige rebuild/redeploy ao alterar.

# URL pública do backend FastAPI.
# Local (dev): http://localhost:8000
# Produção (state-alvo canônico): https://empreganoix.onrender.com
# Usada no browser para login/reveal/report/admin. OBRIGATÓRIA em produção.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL do backend usada apenas no SSR (fetch server-side do board).
# Lida em RUNTIME no servidor (não é inlined no build) — em produção aponta
# para a mesma URL pública do backend. Opcional em dev (cai para a pública).
# Produção (state-alvo canônico): https://empreganoix.onrender.com
BACKEND_API_URL=http://localhost:8000

# Site key pública do widget Cloudflare Turnstile (widget de produção).
# Em dev, se ausente, usa a chave pública always-pass do Cloudflare.
# Produção: Hostnames do widget devem incluir a origem canônica `empreganoix.vercel.app`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Integração social/Meta e operação de cron: segredos, chaves privadas e tokens (app secret Meta,
# chave de criptografia de tokens sociais, segredos de worker/cron, tokens OAuth/page) são
# exclusivamente backend-only. Não adicione variáveis NEXT_PUBLIC_* para esses valores.
# Configurar via backend/.env(.example)/Render.

# --- Controles públicos por ambiente (Phase 27 / ADS-01, DONA-01) ---
# Exibição de espaços publicitários (flag única, todos os placements: header/sidebar/inline).
# Padrão: mostrar anúncios quando ausente/vazio/qualquer valor não explicitamente desativado (D-01).
# Para ocultar explicitamente: false, 0, off, no, disabled (case-insensitive).
# NEXT_PUBLIC_* é embutida no build: exige rebuild/redeploy ao alterar.
NEXT_PUBLIC_ADS_ENABLED=true

# URL de doação externa do botão "Doações" no header.
# Aceita apenas URL absoluta http:// ou https:// válida.
# Quando configurada e válida: abre em nova aba (target="_blank", rel="noopener noreferrer") (D-04).
# Quando ausente/vazia/inválida (ex.: javascript:, data:, relativa, malformada): fallback seguro para /doacoes (D-05).
# A página interna /doacoes permanece acessível em qualquer caso (D-06).
# NEXT_PUBLIC_* é embutida no build: exige rebuild/redeploy ao alterar.
NEXT_PUBLIC_DONATION_URL=
