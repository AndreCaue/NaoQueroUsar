NEXT_PUBLIC_API_URL=http://localhost:8000
# Public Turnstile site key (safe to expose in the browser).
# Empty in dev = use the Cloudflare always-pass test key; mandatory in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# .env.local is gitignored and must not be committed
# Local-dev defaults only. Em produção (state-alvo canônico, Vercel): NEXT_PUBLIC_API_URL e
# BACKEND_API_URL devem apontar para https://empreganoix.onrender.com (com rebuild/redeploy para NEXT_PUBLIC_*).

# Ads: padrão mostrar; defina false/0/off/no/disabled para ocultar.
NEXT_PUBLIC_ADS_ENABLED=true
# Doação: URL absoluta http(s) válida; vazio/inválido => fallback /doacoes.
NEXT_PUBLIC_DONATION_URL=
