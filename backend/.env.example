ENV=dev
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
ADMIN_PASSWORD_HASH=
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=43200
CORS_ORIGINS=http://localhost:3000
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/TESTDBNAME?ssl=require

# --- Groq / Extração (Phase 2) ---
# Obter em https://console.groq.com/keys (vazio = endpoint de extração retorna erro claro)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
EXTRACT_CHUNK_MAX_TOKENS=3500
EXTRACT_MAX_TEXT_BYTES=262144
EXTRACT_MAX_JOBS=50
EXTRACT_CHUNK_DELAY_SECONDS=2.5
EXTRACT_TIMEOUT_SECONDS=180
