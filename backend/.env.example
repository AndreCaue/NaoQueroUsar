ENV=dev
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
ADMIN_PASSWORD_HASH=
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=43200
CORS_ORIGINS=http://localhost:3000
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/TESTDBNAME?ssl=require

# --- Groq / Extração (Phase 2) ---
# Obter em https://console.groq.com/keys (vazio = endpoint de extração retorna erro claro)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
EXTRACT_CHUNK_MAX_TOKENS=3500
EXTRACT_MAX_TEXT_BYTES=262144
EXTRACT_MAX_JOBS=50
EXTRACT_CHUNK_DELAY_SECONDS=2.5
EXTRACT_TIMEOUT_SECONDS=180

# --- Cloudflare Turnstile / Rate Limit (Phase 3) ---
# Criar o widget em https://dash.cloudflare.com/ → Turnstile → Add widget
# (sitekey = pública, secret = privada). Nunca versionar o secret real.
# Em ENV=dev o TURNSTILE_SECRET_KEY pode ficar VAZIO: o backend usa a chave
# pública always-pass do Cloudflare (1x…AA). Fora de dev o secret é OBRIGATÓRIO
# — ausente (ou uma chave de teste 1x/2x/3x) o startup do backend falha (D-11/D-12).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=10
# Limites de rate limit (D-06) — ajustáveis por env, sem novo deploy.
REVEAL_RATE_LIMIT=10/minute
LOGIN_RATE_LIMIT=5/minute
