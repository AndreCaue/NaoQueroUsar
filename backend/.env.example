ENV=dev
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?ssl=require
ADMIN_PASSWORD_HASH=
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=43200
CORS_ORIGINS=http://localhost:3000
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/TESTDBNAME?ssl=require

# --- Groq / Extração (Phase 2) ---
# Obter em https://console.groq.com/keys (vazio = endpoint de extração retorna erro claro)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
EXTRACT_CHUNK_MAX_TOKENS=3500
EXTRACT_MAX_TEXT_BYTES=262144
EXTRACT_MAX_JOBS=50
EXTRACT_CHUNK_DELAY_SECONDS=2.5
EXTRACT_TIMEOUT_SECONDS=180

# --- Cloudflare Turnstile / Rate Limit (Phase 3) ---
# Criar o widget em https://dash.cloudflare.com/ → Turnstile → Add widget
# (sitekey = pública, secret = privada). Nunca versionar o secret real.
# Em ENV=dev o TURNSTILE_SECRET_KEY pode ficar VAZIO: o backend usa a chave
# pública always-pass do Cloudflare (1x…AA). Fora de dev o secret é OBRIGATÓRIO
# — ausente (ou uma chave de teste 1x/2x/3x) o startup do backend falha (D-11/D-12).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_SECONDS=10
# Limites de rate limit (D-06) — ajustáveis por env, sem novo deploy.
REVEAL_RATE_LIMIT=10/minute
LOGIN_RATE_LIMIT=5/minute

# --- Integração Social / Meta (Phase 14 - Fundação) ---
# Variáveis para a fundação da integração com Meta/Facebook (SOC-06) e operação social (v1.2).
# Segredos, chaves e tokens ficam apenas no backend e nunca devem ser expostos ao frontend ou logs.
# Preencha os segredos somente no ambiente real (.env/deploy), sem versionar valores reais.
# SOCIAL_TOKEN_ENCRYPTION_KEY deve ser uma chave Fernet válida (32 bytes url-safe base64) quando preenchida.
# SOCIAL_RETRY_DELAYS é uma lista CSV de inteiros em segundos.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_OAUTH_REDIRECT_URI=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_WORKER_SECRET=
SOCIAL_MAX_ATTEMPTS=5
SOCIAL_RETRY_DELAYS=300,900,3600,10800,21600
SITE_PUBLIC_URL=
# Por padrão o post social NÃO inclui nome da empresa nem contatos (telefone/e-mail); mantém apenas link público da vaga (POST-06/D-15). Altere para true apenas se política futura documentada exigir contato (não recomendado).
SOCIAL_POST_INCLUDE_CONTACT=false

# --- Instagram / Mídia IG (Phase 29) ---
# Base pública HTTPS do backend usada para servir mídia IG acessível pela Meta. Não usar localhost/IP privado.
MEDIA_PUBLIC_BASE_URL=

# Instagram / Publish pipeline (Phase 31) - budgets/limites operacionais (não são segredos)
IG_PUBLISH_HTTP_TIMEOUT_SECONDS=20.0
IG_STATUS_POLL_MAX_ATTEMPTS=5
IG_STATUS_POLL_DELAY_SECONDS=2.0
IG_PUBLISH_MAX_ATTEMPT_SECONDS=45.0

# --- Chat-search público (Phase 20 / API-01..03) ---
# Rate limit dedicado por IP/rota para o chat-search público.
CHAT_SEARCH_RATE_LIMIT=20/minute
# Limite curto de caracteres da mensagem para reduzir abuso/custo.
CHAT_SEARCH_MAX_MESSAGE_CHARS=400
# Timeout curto da extração de intenção no chat, com fallback controlado (desacoplado do GROQ_TIMEOUT_SECONDS admin).
CHAT_SEARCH_INTENT_TIMEOUT_SECONDS=12
# Kill-switch operacional do chat-search público (QA-03/D-06). Quando false, endpoint responde desativado com guidance para busca manual e UI oculta o chat; board/listagem manual permanecem intactos.
CHAT_SEARCH_ENABLED=true

# --- Cron / operação agendada (expiração e worker social) ---
# CRON_SECRET protege endpoints operacionais acionados por cron (X-Cron-Secret, fail-closed T-06-01):
#   - POST /api/v1/admin/expire (expiração/catch-up)
#   - POST /api/v1/admin/social/worker (publicação social assíncrona/retry, 1-5 min)
# Use o MESMO segredo no executor do cron (Render/GitHub Actions). Não versionar valor real.
CRON_SECRET=
# Scheduler in-process (APScheduler) para expiração; pode ser desativado se depender apenas de cron externo.
SCHEDULER_ENABLED=true
